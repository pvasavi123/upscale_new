# ---------------------------------------------------------------------------
# Environment variables for the Vercel deployment.
# Add these in: Vercel dashboard -> Project -> Settings -> Environment Variables
# ALL OF THEM ARE OPTIONAL - the chatbot works with none of them set.
# ---------------------------------------------------------------------------

# Optional. Without it the chatbot uses its built-in rule-based replies.
# Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Optional. Defaults to gemini-1.5-flash.
GEMINI_MODEL=gemini-1.5-flash

# WhatsApp number that leads are handed off to (digits only, country code optional).
WHATSAPP_NUMBER=9063593070

# Optional. If set, every captured lead is POSTed here as JSON
# (Zapier / Make / Google Apps Script / your own endpoint).
LEAD_WEBHOOK_URL=

# Optional. Comma-separated list of origins allowed to call the API.
# Leave empty to allow the deployed site itself (default).
ALLOWED_ORIGINS=
